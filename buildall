#!/bin/bash

# Build minideb images for each supported dist × arch.
# Note: cross-arch builds require QEMU/binfmt on the host; for native-arch only,
# pass ARCHS via env, e.g. ARCHS="arm64" ./buildall

set -e
set -u
set -o pipefail

ARCHS=${ARCHS:-"amd64 arm64"}
DISTS=${DISTS:-"trixie sid"}

for a in $ARCHS; do
  for i in $DISTS; do
    ./buildone "$i" "$a"
  done
done

